#version 450
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = params.viewportWindow.xy;
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float aspect = float(size.x) / float(size.y);
    float minU=params.uvBounds.x, maxU=params.uvBounds.y, minV=params.uvBounds.z, maxV=params.uvBounds.w;
    float centerU=(minU+maxU)*0.5, centerV=(minV+maxV)*0.5;
    float halfU=max((maxU-minU)*0.5,1e-5), halfV=max((maxV-minV)*0.5,1e-5);
    if (aspect > halfU/halfV) halfU=halfV*aspect; else halfV=halfU/aspect;
    vec3 world=params.origin.xyz+params.axisU.xyz*(centerU+(uv.x-0.5)*2*halfU)+params.axisV.xyz*(centerV+(uv.y-0.5)*2*halfV);
    vec3 coord=world/params.volumeSize.xyz+0.5;
    vec3 rgb=vec3(0);
    if (all(greaterThan(coord,vec3(0))) && all(lessThan(coord,vec3(1)))) {
        float hu=sampleVolume(coord)-1024.0;
        rgb=vec3(clamp((hu-(params.viewportWindow.z-params.viewportWindow.w*0.5))/params.viewportWindow.w,0.0,1.0));
    }
    outputPixels[pixel.x+pixel.y*size.x]=bgra(rgb);
}
